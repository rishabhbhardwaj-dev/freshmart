generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id          Int     @id
  name        String
  price       Decimal @db.Decimal(10, 2)
  category    String
  image       String
  unit        String
  inStock     Boolean
  description String
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}